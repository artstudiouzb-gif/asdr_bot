# ─── Приложение ──────────────────────────────────────────────────────────────
APP_ENV=production
APP_URL=https://asdr.uz/panel
# Ключ подписи cookie и шифрования токенов. Сгенерировать: php bin/genkey.php
APP_KEY=
TIMEZONE=Asia/Tashkent

# ─── База данных ─────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASS=

# ─── Telegram ────────────────────────────────────────────────────────────────
# my.telegram.org → API development tools
TG_API_ID=
TG_API_HASH=

# ─── Запуск воркера по URL (если cron умеет только curl) ─────────────────────
CRON_KEY=

# ─── Логи ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
LOG_RETENTION_DAYS=30

# Одноразовый ключ для install.php (после установки файл удалить)
INSTALL_KEY=
