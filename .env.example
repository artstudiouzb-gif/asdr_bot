# ---------- Telegram ----------
# my.telegram.org -> API development tools
API_ID=1234567
API_HASH=0123456789abcdef0123456789abcdef
# Строка сессии из `python -m asdr login` (обязательна для шаред-хостинга)
SESSION=

# Каналы-источники: @username, ссылка t.me/... или числовой id, через запятую
SOURCES=shmirziyoyev, @uzbekistan_news
# Куда публикуем: @username вашего канала или числовой id (-100...)
TARGET=@my_news_channel

# Публиковать от имени бота (бот должен быть админом TARGET).
# Пусто — публикуем от имени аккаунта из SESSION.
# Этот же бот используется для входа в веб-панель.
BOT_TOKEN=
# Имя бота без @ — нужно кнопке «Войти через Telegram» в панели
BOT_USERNAME=
# Telegram ID тех, кому открыта панель (через запятую). Свой ID покажет сама
# страница входа при первой попытке войти.
ADMIN_IDS=

# copy — пересобрать пост заново (очистка работает), forward — обычная пересылка
MODE=copy

# ---------- Очистка ----------
# Домены, ссылки на которые считаются подписью источника и вырезаются
BLOCKED_DOMAINS=president.uz,prezident.uz,facebook.com,instagram.com,youtube.com,youtu.be,x.com,twitter.com,t.me
# Разворачивать оставшиеся ссылки на эти домены в обычный текст
UNWRAP_BLOCKED_LINKS=true
# Удалять строки-призывы «подпишитесь на канал»
DROP_SUBSCRIBE_LINES=true
DROP_HASHTAGS=false
# Дополнительные регулярки — одна на строку в patterns/drop_lines.txt и patterns/remove.txt
# Своя подпись в конце поста. Удобнее держать её в patterns/footer.html
# (там уже лежит подпись ASR: website | facebook | Instagram | linkedIn | youtube),
# FOOTER в .env — запасной вариант, если файла нет.
FOOTER=
ADD_SOURCE_LINK=false

# ---------- Фильтры ----------
INCLUDE_KEYWORDS=
EXCLUDE_KEYWORDS=реклама,erid
MIN_TEXT_LENGTH=0
SKIP_WITHOUT_TEXT=false
SKIP_MEDIA=false
SKIP_FORWARDS=false
SILENT=false

# ---------- Лимиты для шаред-хостинга ----------
# Сколько сообщений тянуть из канала за один запуск
POLL_LIMIT=20
# Не больше стольких постов за один запуск cron
MAX_POSTS_PER_RUN=10
# Сколько секунд максимум работает процесс (хостинг убивает долгие задачи)
MAX_RUNTIME=120
DELAY_BETWEEN_POSTS=3
# 0 — начать с текущего момента; N — при первом запуске взять N последних постов
BACKFILL_ON_FIRST_RUN=0
# Каталог для базы, лога и лок-файла
DATA_DIR=data

# ---------- Запуск по URL и веб-панель ----------
# Секрет для cron по URL: https://домен/run?key=...
WEB_SECRET=
